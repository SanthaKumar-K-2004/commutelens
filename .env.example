# Browser Key: restricted by HTTP referrers to your domains and Maps/Places APIs
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your_referrer_restricted_browser_key

# Server Key: Google Air Quality & Weather APIs (never expose in client code)
GOOGLE_ENVIRONMENT_API_KEY=your_server_only_environment_key

# Server Key: Optional Google Places (New) Text Search
GOOGLE_PLACES_SERVER_KEY=optional_server_places_key

# OpenTripPlanner 2.10 GraphQL endpoint (optional, defaults to embedded GTFS transit.db if not running)
OTP_GRAPHQL_URL=http://localhost:8080/otp/gtfs/v1

# Force presentation demo data fallback (set to true only for offline demonstration)
FORCE_DEMO_DATA=false
